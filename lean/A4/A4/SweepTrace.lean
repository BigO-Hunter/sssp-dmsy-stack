import A4.RunTrace

/-!
# Frontier.DMSY.SweepTrace — the instrumented (E2)-gated sweeps

Work package **A4 (BMSSP recursion)**, the operational half of the `RunTrace` seam.  This file
instruments the three sweep functions of `A4.Semantics` so that the acceptance history
(`RunTrace.Trace`) is *generated by execution*, not assumed:

* `relaxGateT` — the gated relaxation, emitting at most one `RelaxStep`;
* `sweepGateT` — the out-edge sweep of one vertex, concatenating its accepted steps;
* `sweepEvtsT` — the settlement-log sweep driver, concatenating per-event steps.

Soundness is exact: erasing the trace (the first two components) recovers the original
`relaxGate` / `sweepGate` / `sweepEvts` of `A4.Semantics`.  Every emitted `RelaxStep` is a
genuine accepted relaxation — the correct edge, the correct acceptance-time source label
`d (G.src e)`, the correct target label `ext (d (G.src e)) e`, and the gate `lo ≤ vv ∧ vv < B ∧
vv ≤ d (G.dst e)` all hold (ties included: the gate is `≤`, exactly `relaxGate`'s re-acceptance).
The only thing *not* yet done is lifting the trace through `IStep`/`ILoop`/`Run` — named at the
bottom as the single next obligation.
-/

namespace Frontier
namespace DMSY

open Frontier Graph
open Frontier.CHD

variable {G : Graph} {s : Fin G.n}

/-! ## The one new proof ingredient -/

/-- A relaxation candidate that is `⊤` cannot be strictly below its bound, so an accepted
candidate has a finite (non-`⊤`) source label. -/
theorem ne_top_of_ext_lt_top {lab : WLab G s} {e : Fin G.m} (h : ext lab e < (⊤ : WLab G s)) :
    lab ≠ ⊤ := by
  intro htop
  rw [htop, ext_top] at h
  exact (lt_irrefl (⊤ : WLab G s) h).elim

/-! ## Instrumented `relaxGate` -/

/-- `relaxGate` plus its acceptance trace: the third component is `[step]` when the gate accepts
(exactly the same `lo ≤ cand ∧ cand < B ∧ cand ≤ d (G.dst e)` test, ties re-accepted via `≤`),
`[]` when it refuses.  The `RelaxStep` records the edge, the acceptance-time source label
`d (G.src e)`, and the written target label `ext (d (G.src e)) e`. -/
noncomputable def relaxGateT (B lo : WLab G s) (d : Labels G s) (D : DS G s) (e : Fin G.m) :
    Labels G s × DS G s × List (RelaxStep G s) :=
  let cand := ext (d (G.src e)) e
  if hc : lo ≤ cand ∧ cand < B ∧ cand ≤ d (G.dst e) then
    (Function.update d (G.dst e) cand, DS.insert D (G.dst e) cand,
      [⟨e, G.src e, G.dst e, d (G.src e), cand, rfl, rfl,
        ne_top_of_ext_lt_top (lt_of_lt_of_le hc.2.1 le_top), rfl⟩])
  else (d, D, [])

/-- Erasing the trace recovers `relaxGate`'s labels component. -/
theorem relaxGateT_fst (B lo : WLab G s) (d : Labels G s) (D : DS G s) (e : Fin G.m) :
    (relaxGateT B lo d D e).1 = (relaxGate B lo d D e).1 := by
  by_cases hc : lo ≤ ext (d (G.src e)) e ∧ ext (d (G.src e)) e < B ∧
      ext (d (G.src e)) e ≤ d (G.dst e) <;> simp [relaxGateT, relaxGate, hc]

/-- Erasing the trace recovers `relaxGate`'s structure component. -/
theorem relaxGateT_snd (B lo : WLab G s) (d : Labels G s) (D : DS G s) (e : Fin G.m) :
    (relaxGateT B lo d D e).2.1 = (relaxGate B lo d D e).2 := by
  by_cases hc : lo ≤ ext (d (G.src e)) e ∧ ext (d (G.src e)) e < B ∧
      ext (d (G.src e)) e ≤ d (G.dst e) <;> simp [relaxGateT, relaxGate, hc]

/-- Every emitted `RelaxStep` is the accepted edge, with the correct acceptance-time pre/post
labels, and the gate really held (ties included: `vv ≤ d (G.dst e)`). -/
theorem relaxGateT_mem (B lo : WLab G s) (d : Labels G s) (D : DS G s) (e : Fin G.m)
    {r : RelaxStep G s} (h : r ∈ (relaxGateT B lo d D e).2.2) :
    r.e = e ∧ r.uv = d (G.src e) ∧ r.vv = ext (d (G.src e)) e ∧
      lo ≤ r.vv ∧ r.vv < B ∧ r.vv ≤ d (G.dst e) := by
  by_cases hc : lo ≤ ext (d (G.src e)) e ∧ ext (d (G.src e)) e < B ∧
      ext (d (G.src e)) e ≤ d (G.dst e)
  · simp [relaxGateT, hc] at h
    subst h
    exact ⟨rfl, rfl, rfl, hc.1, hc.2.1, hc.2.2⟩
  · simp [relaxGateT, hc] at h

/-! ## Instrumented `sweepGate` and `sweepEvts` -/

/-- `sweepGate` plus its acceptance trace (the accepted out-edge relaxations of `u`, in
edge-index order). -/
noncomputable def sweepGateT (B lo : WLab G s) (u : Fin G.n) : List (Fin G.m) →
    Labels G s → DS G s → Labels G s × DS G s × List (RelaxStep G s)
  | [], d, D => (d, D, [])
  | e :: es, d, D =>
    let r := relaxGateT B lo d D e
    let a := sweepGateT B lo u es (if G.src e = u then r.1 else d)
      (if G.src e = u then r.2.1 else D)
    (a.1, a.2.1, (if G.src e = u then r.2.2 else []) ++ a.2.2)

/-- Erasing the trace recovers `sweepGate`'s labels component. -/
theorem sweepGateT_fst (B lo : WLab G s) (u : Fin G.n) :
    ∀ es d D, (sweepGateT B lo u es d D).1 = (sweepGate B lo u es d D).1 := by
  intro es
  induction es with
  | nil => intro d D; rfl
  | cons e es ih =>
      intro d D
      simp [sweepGateT, sweepGate, relaxGateT_fst, relaxGateT_snd]
      exact ih _ _

/-- Erasing the trace recovers `sweepGate`'s structure component. -/
theorem sweepGateT_snd (B lo : WLab G s) (u : Fin G.n) :
    ∀ es d D, (sweepGateT B lo u es d D).2.1 = (sweepGate B lo u es d D).2 := by
  intro es
  induction es with
  | nil => intro d D; rfl
  | cons e es ih =>
      intro d D
      simp [sweepGateT, sweepGate, relaxGateT_fst, relaxGateT_snd]
      exact ih _ _

/-- `sweepEvts` plus its acceptance trace (the concatenation of the per-event sweep traces). -/
noncomputable def sweepEvtsT (B lo : WLab G s) : List (SettlementEvent G) →
    Labels G s → DS G s → Labels G s × DS G s × List (RelaxStep G s)
  | [], d, D => (d, D, [])
  | ev :: evts, d, D =>
    let a := sweepGateT B lo ev.v (List.finRange G.m) d D
    let b := sweepEvtsT B lo evts a.1 a.2.1
    (b.1, b.2.1, a.2.2 ++ b.2.2)

/-- Erasing the trace recovers `sweepEvts`'s labels component. -/
theorem sweepEvtsT_fst (B lo : WLab G s) :
    ∀ evts d D, (sweepEvtsT B lo evts d D).1 = (sweepEvts B lo evts d D).1 := by
  intro evts
  induction evts with
  | nil => intro d D; rfl
  | cons ev evts ih =>
      intro d D
      simp [sweepEvtsT, sweepEvts, sweepGateT_fst, sweepGateT_snd]
      exact ih _ _

/-- Erasing the trace recovers `sweepEvts`'s structure component. -/
theorem sweepEvtsT_snd (B lo : WLab G s) :
    ∀ evts d D, (sweepEvtsT B lo evts d D).2.1 = (sweepEvts B lo evts d D).2 := by
  intro evts
  induction evts with
  | nil => intro d D; rfl
  | cons ev evts ih =>
      intro d D
      simp [sweepEvtsT, sweepEvts, sweepGateT_fst, sweepGateT_snd]
      exact ih _ _

/-! ## Chain linkage for consecutive accepted relaxations -/

/-- Two accepted relaxations concatenate into a `ContigFrom` trace exactly when the first's
target is the second's source with the same label — the operational condition that makes the
acceptance history a genuine improvement *chain* rather than an unordered bag of relaxations. -/
theorem contigFrom_cons_of_link {r₁ r₂ : RelaxStep G s} (hvu : r₁.v = r₂.u) (hvv : r₁.vv = r₂.uv) :
    ContigFrom G s r₁.u r₁.uv [r₁, r₂] r₂.v r₂.vv := by
  refine ContigFrom.cons r₁ [r₂] r₂.v r₂.vv ?_
  rw [hvu, hvv]
  exact ContigFrom.step r₂

end DMSY
end Frontier
